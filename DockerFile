FROM node:20-slim AS client-build
WORKDIR /app/client
COPY client/package*.json ./
RUN npm install
COPY client/ ./
RUN npm run build

FROM node:20-slim
WORKDIR /app/server
COPY server/package*.json ./
RUN npm install --omit=dev
COPY server/ ./
COPY --from=client-build /app/client/dist ../client/dist
RUN mkdir -p images

ENV PORT=5000
ENV MONGODB_URI=mongodb://127.0.0.1:27017/foodeazy
ENV JWT_SECRET=food_eazy_dev_secret

EXPOSE 5000
CMD ["node", "server.js"]
