# 服务端口
PORT=5000

# MongoDB 连接地址
MONGODB_URI=mongodb://127.0.0.1:27017/foodeazy

# JWT 签名密钥
JWT_SECRET=food_eazy_dev_secret

# 站点对外访问地址（用于邮件链接与支付回调）
PUBLIC_BASE_URL=http://localhost:5000

# SendGrid 邮件服务（留空时邮件发送会被跳过，验证码打印在服务端日志）
SEND_GRID_KEY=

# Cloudinary 图片存储（留空时图片保存到本地 images 目录）
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PayTM 支付（留空时仅可使用货到付款）
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_API_KEY=
PAYTM_TXN_URL=https://securegw-stage.paytm.in/order/process
